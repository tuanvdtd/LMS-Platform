# Bắt buộc
# Supabase transaction pooler :6543 ?pgbouncer=true
DATABASE_URL=
# session pooler / direct, cho migrate
DIRECT_URL=
# Upstash rediss://
REDIS_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
FE_URL=http://localhost:3000
BREVO_API_KEY=
MAIL_FROM_NAME=SkillPath
# phải là sender/domain đã xác minh trong Brevo
MAIL_FROM_EMAIL=no-reply@mail.tuandt.me

# RabbitMQ trên CloudAMQP, dạng amqps://... (spec rabbitmq-mail-queue). Dev dùng instance riêng, không chung production.
RABBITMQ_URL=

# Cloudflare R2 (spec curriculum-upload §4.1). Token Object Read & Write cho 2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# bucket công khai (ảnh bìa) + domain công khai của nó, không có / cuối
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
# bucket riêng tư (PDF), xem bằng presigned GET
R2_PRIVATE_BUCKET=

# AWS S3 video bài giảng (spec video-upload §9). AWS_REGION phải trùng region của bucket. IAM: Put/Get/DeleteObject trên videos/*, ListBucket trên bucket.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_VIDEO_BUCKET=

# CloudFront trước bucket video (tuỳ chọn). Đặt đủ cả 3 → video phát qua CloudFront bằng signed URL;
# bỏ trống cả 3 → presigned S3 như cũ; đặt thiếu → back-end không khởi động.
# Domain chỉ là host, vd d123abc.cloudfront.net. Key pair ID = ID public key trong key group của distribution.
# Private key: base64 một dòng của file PEM, `base64 -i cf-private.pem | tr -d '\n'`.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_BASE64=

# Stripe test mode (spec stripe-checkout §4). Webhook secret lấy từ `stripe listen --forward-to localhost:4000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Piston chạy code học viên (spec coding-exercise §10). Mặc định dev http://127.0.0.1:2000; prod chung máy: http://piston:2000
PISTON_URL=

# Không bắt buộc
# prod: .skillpath.tuandt.me — để trống khi dev
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PORT=4000
# Sentry project skillpath-api. Để trống = tắt
SENTRY_DSN=
# development | production
SENTRY_ENVIRONMENT=development
# off = không chạy consumer (vitest e2e đặt sẵn)
RABBITMQ_CONSUMERS=
